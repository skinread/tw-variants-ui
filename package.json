{
  "name": "tw-variants-ui",
  "author": "Sean Kinread",
  "description": "A UI library powered by Tailwind CSS and React",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skinread/tw-variants-ui.git"
  },
  "version": "0.1.2",
  "type": "module",
  "types": "./dist/react/index.d.ts",
  "exports": {
    "./react": {
      "require": "./dist/react/index.cjs",
      "import": "./dist/react/index.js"
    },
    "./tailwind-preset": "./dist/tailwind-preset.js",
    "./themes": "./dist/themes/index.js",
    "./tokens": "./dist/tokens/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "husky",
    "dev": "storybook dev -p 6006",
    "build": "npm run bundle:react && npm run copy:themes && npm run bundle:css",
    "bundle:css": "postcss ./src/styles/tailwind.css -o ./dist/css/tailwind.css",
    "bundle:react": "vite build",
    "copy:themes": "cpy 'src/themes/*' 'dist/themes/' && cpy 'src/tailwind-preset.*' dist && cpy 'src/tokens/*' 'dist/tokens/'",
    "check-deps": "npx npm-check-updates@latest --interactive --format group",
    "format": "prettier src/**/*.{js,jsx,ts,tsx,json} --write",
    "prettier": "prettier src/**/*.{js,ts,tsx} --check",
    "lint": "eslint . --report-unused-disable-directives",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "pretest": "playwright install --with-deps",
    "test": "vitest run",
    "test:ci": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "generate:component": "plop --plopfile generator/plopfile.js",
    "storybook:build": "storybook build",
    "storybook:serve": "npx serve ./storybook-static -p 6007 -d -L -n",
    "storybook:upgrade": "npx sb@latest upgrade",
    "release": "npx dotenv-cli -- release-it",
    "watch": "npm run bundle:react -- --watch & npm run copy:themes & npm run bundle:css"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": "^3.2.2"
  },
  "peerDependencies": {
    "daisyui": "^5.5.19",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "tailwindcss": "*"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.59.1",
    "@storybook/addon-a11y": "^10.3.5",
    "@storybook/addon-coverage": "^3.0.1",
    "@storybook/addon-docs": "^10.3.5",
    "@storybook/addon-links": "^10.3.5",
    "@storybook/addon-themes": "^10.3.5",
    "@storybook/addon-vitest": "^10.3.5",
    "@storybook/react-vite": "^10.3.5",
    "@storybook/test-runner": "^0.24.3",
    "@storybook/web-components-vite": "^10.3.5",
    "@tailwindcss/cli": "^4.2.4",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/browser": "^3.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "autoprefixer": "^10.5.0",
    "axe-playwright": "^2.2.2",
    "cpy-cli": "^7.0.0",
    "daisyui": "^5.5.19",
    "esbuild-plugin-svgr": "^3.1.1",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-storybook": "^10.3.5",
    "eslint-plugin-unicorn": "^64.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "pkg-pr-new": "^0.0.67",
    "playwright": "^1.59.1",
    "plop": "^4.0.5",
    "postcss": "^8.5.11",
    "postcss-cli": "^11.0.1",
    "prettier": "^3.8.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "release-it": "^20.0.1",
    "storybook": "^10.3.5",
    "storybook-dark-mode": "^5.0.0",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.0",
    "vite": "^7.3.0",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-svgr": "^5.2.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "./src/**/*.{js,jsx,ts,tsx,md,html,css,json}": [
      "prettier --ignore-unknown --write"
    ],
    "./src/**/*.{js,jsx,ts,tsx}": [
      "eslint"
    ]
  },
  "overrides": {
    "storybook": "$storybook"
  }
}
